# mainnet | testnet
NETWORK=mainnet
# The deployed readersEXIT contract
CONTRACT_ID=readersexit.near
# Keeper account (must be added via add_keeper to execute DCA orders).
# The key is read from ~/.near-credentials/<network>/<account>.json when KEEPER_PRIVATE_KEY is empty.
# Without any key the keeper runs in dry-run mode (logs what it would execute).
KEEPER_ACCOUNT_ID=keeper.skyto.near
KEEPER_PRIVATE_KEY=
# Optional
# Comma-separated list, rotated on rate limits (defaults to FastNEAR, Intear, NEAR):
# RPC_URL=https://free.rpc.fastnear.com,https://rpc.intea.rs,https://rpc.mainnet.near.org
POLL_MS=15000
SLIPPAGE_BPS=50
# DCA slices with more price impact than this are skipped (thin/trap pools)
MAX_IMPACT_BPS=1000

# --- indexer service (ROLE=indexer) ---
# ROLE=indexer
# DATABASE_URL=postgres://...
# One-off competitions, edited in Railway without a redeploy:
# CAMPAIGNS=[{"id":"launch","name":"Launch Week","start":"2026-10-06T00:00:00Z","end":"2026-10-13T00:00:00Z","prizes":["50 NEAR","25 NEAR","10 NEAR"]}]
DRY_RUN=0
